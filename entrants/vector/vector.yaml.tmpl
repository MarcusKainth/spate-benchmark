# The Vector arm's whole topology: 8 kafka sources -> 8 remap transforms -> 1
# clickhouse sink, in one process on the 6 CPU / 24 GiB envelope.
#
# This file is a TEMPLATE. `__AVRO_SCHEMA_JSON__` is replaced at image build
# with the committed workload/schema/sensor_batch.avsc, minified and embedded as
# a double-quoted YAML scalar — methodology/ forbids re-declaring the schema
# inline, and baking it from the one committed file is what keeps that true for
# a system with no Schema Registry client. Every dollar-brace placeholder is
# resolved by Vector's own env-var interpolation at start-up (which 0.57 gates
# behind VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION=true — set in the
# Dockerfile, because without it every knob here would silently no-op). The
# interpolator reads the RAW file text, comments included, so no comment in this
# file may spell a literal placeholder. The defaults after `:-` equal the
# published knobs, so a reviewer starting the container by hand gets the
# configuration the numbers describe.
#
# WHY EIGHT SOURCES: a Vector kafka source is one librdkafka consumer whose
# decoding runs in that source's own task, and the maintainers' guidance for
# scaling is one source per partition (vectordotdev/vector discussion #15884).
# The topic has 8 partitions; eight sources in the same consumer group, under
# cooperative-sticky assignment, settle at exactly one partition each. The
# envelope allows one container, so the eight consumers share the process.
# `in-1`..`in-7` are YAML aliases of `in-0`: the blocks are IDENTICAL by
# construction, and the alias makes that a parser-enforced fact rather than a
# copy-paste promise. (Plain anchors/aliases only — `<<:` merge keys are not
# supported by Vector's YAML loader. If aliases ever regress, enumerate the
# eight blocks literally; `vector validate` in the Dockerfile is the guard.)
#
# WHY EIGHT REMAPS: a remap transform is one task. A single shared remap fed by
# eight sources would serialize the fan-out — the hottest per-row work in the
# pipeline — onto one core. One remap per source keeps decode and transform
# parallel at the topic's width; all eight load the same committed
# /etc/vector/transform.vrl, so there is still exactly one transform to review.

# No published figure comes from an arm's self-report, and an idle API server is
# still a listener on the measured process.
api:
  enabled: false

sources:
  in-0: &kafka_source
    type: kafka
    bootstrap_servers: "${BOOTSTRAP}"
    topics: ["${TOPIC}"]
    group_id: "${GROUP_ID}"
    # Drain replays a prefilled corpus from the beginning; sustained starts at
    # the tail. The driver supplies the mode's value.
    auto_offset_reset: "${AUTO_OFFSET_RESET:-earliest}"
    # The durability cadence, matched to the 5 s every arm pays (Spate's offset
    # commits, Flink's checkpoints). Also Vector's shipped default — set
    # explicitly so the cadence is a statement, not an inheritance. With
    # acknowledgements on (sink, below), an offset only commits once ClickHouse
    # has acked every row derived from the message.
    commit_interval_ms: 5000
    decoding:
      codec: avro
      avro:
        # THE schema, baked at image build from the committed .avsc. Vector has
        # no Schema Registry integration, so the schema is static and
        # `strip_schema_id_prefix` discards the 5-byte Confluent frame without
        # validating the id — declared as a deviation in entrant.toml, not
        # smoothed over here.
        schema: __AVRO_SCHEMA_JSON__
        strip_schema_id_prefix: true
    librdkafka_options:
      # Eight consumers, eight partitions: cooperative-sticky settles at one
      # partition per consumer and rebalances incrementally rather than
      # stop-the-world, so a late-joining consumer does not stall the other
      # seven at start-up.
      "partition.assignment.strategy": "cooperative-sticky"
      # 8 MiB per fetched message, comfortably above the corpus's largest
      # Confluent-framed batch; librdkafka's 1 MiB default would truncate
      # fetches into more round-trips than the payload needs.
      "fetch.message.max.bytes": "8388608"
      # 256 MiB of prefetch per consumer (the option is in KILOBYTES). The
      # shipped default (~64 MiB in 0.57's librdkafka) is a prefetch bound, and
      # in drain mode the consumer must never be the starved side: 8 x 256 MiB
      # is still small against the 24 GiB envelope.
      "queued.max.messages.kbytes": "262144"
  in-1: *kafka_source
  in-2: *kafka_source
  in-3: *kafka_source
  in-4: *kafka_source
  in-5: *kafka_source
  in-6: *kafka_source
  in-7: *kafka_source

# One remap per source; all eight compile the same committed program. The
# fan-out happens inside it: assigning an array to `.` emits one event per
# element, and acknowledgement state is shared across the children, so
# at-least-once survives the 1:100 explosion.
transforms:
  shape-0:
    type: remap
    inputs: ["in-0"]
    file: /etc/vector/transform.vrl
  shape-1:
    type: remap
    inputs: ["in-1"]
    file: /etc/vector/transform.vrl
  shape-2:
    type: remap
    inputs: ["in-2"]
    file: /etc/vector/transform.vrl
  shape-3:
    type: remap
    inputs: ["in-3"]
    file: /etc/vector/transform.vrl
  shape-4:
    type: remap
    inputs: ["in-4"]
    file: /etc/vector/transform.vrl
  shape-5:
    type: remap
    inputs: ["in-5"]
    file: /etc/vector/transform.vrl
  shape-6:
    type: remap
    inputs: ["in-6"]
    file: /etc/vector/transform.vrl
  shape-7:
    type: remap
    inputs: ["in-7"]
    file: /etc/vector/transform.vrl

sinks:
  clickhouse:
    type: clickhouse
    inputs:
      - shape-0
      - shape-1
      - shape-2
      - shape-3
      - shape-4
      - shape-5
      - shape-6
      - shape-7
    endpoint: "${CLICKHOUSE_URL}"
    database: default
    table: sensor_events
    # The variant axis: `arrow_stream` (default; fetches the table schema from
    # system.columns once at start-up, vector#24373, beta in 0.57) or
    # `json_each_row` (the GA control). Not the same server-side work, which is
    # why both are published.
    format: "${FORMAT:-arrow_stream}"
    # DateTime64 columns receive epoch-derived timestamps; best-effort parsing
    # is what lands them at full precision rather than rejected.
    date_time_best_effort: true
    # An unknown field in an insert would mean the transform emitted a column
    # the table does not have — a bug this arm wants to fail on, not absorb.
    skip_unknown_fields: false
    auth:
      strategy: basic
      user: default
      password: bench
    query_settings:
      async_insert_settings:
        # ClickHouse 26.3 defaults async_insert ON, under which the server acks
        # before the data is written — an ack the e2e-acknowledgement chain
        # below would then trust. Unset here means the server's default; false
        # means what the guarantee needs.
        enabled: false
    batch:
      # 262144 rows per INSERT, equal to Spate's cap so the cross-arm batch
      # quantity is comparable. The shipped 10 MiB byte bound would seal at
      # roughly 40k of these rows first, so the byte cap is lifted to 256 MiB —
      # high enough that EVENTS bind and the declared batch size is the real
      # one.
      max_events: ${SINK_BATCH_EVENTS:-262144}
      max_bytes: 268435456
      # Bounds sustained-mode p99; in drain, batches fill on size first.
      # Sweepable.
      timeout_secs: ${SINK_BATCH_TIMEOUT_SECS:-1}
    request:
      # Fixed width rather than the default adaptive (ARC) controller: a drain
      # window is tens of seconds, and ARC spends exactly that long probing its
      # way up. Eight concurrent INSERTs is the width the other arms hold.
      concurrency: ${SINK_REQUEST_CONCURRENCY:-8}
    buffer:
      type: memory
      # The shipped default is 500 EVENTS, which cannot even feed one
      # 262144-row batch; the batcher would starve on every seal. 2x the batch
      # so the next batch fills while the last drains.
      max_events: ${SINK_BUFFER_EVENTS:-524288}
      # Backpressure, not loss: `drop_newest` would break at-least-once while
      # flattering throughput. Block propagates to the sources, which is what
      # pausing consumption is for.
      when_full: block
    # The load-bearing line. End-to-end acknowledgements are what connect a
    # ClickHouse ack back to the source's offset commit; without it the 5 s
    # commit interval commits offsets for rows the sink may still lose.
    acknowledgements:
      enabled: true
    # The shipped default is gzip, which spends the envelope's scarce CPU to
    # save same-host bandwidth the environment has in abundance.
    compression: "${SINK_COMPRESSION:-none}"
