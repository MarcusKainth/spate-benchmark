# No dependency lifecycle script runs on install. A postinstall hook is arbitrary
# code execution from the dependency tree, on every machine that installs, and
# this project has no dependency that legitimately needs one.
#
# Prefer `npm ci` over `npm install`: it installs the committed lockfile verbatim
# instead of re-resolving it.
#
# NOTE, because it costs a confusing build failure otherwise: this also disables
# THIS package's own lifecycle hooks, so `prebuild` and `prestart` never fire.
# Anything that must run before a build is therefore chained explicitly in the
# `build` script rather than written as a `pre*` hook. The protection is worth
# more than the convenience — a postinstall hook is arbitrary code execution from
# the dependency tree — but the interaction is not obvious from either file alone.
ignore-scripts=true
